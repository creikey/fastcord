@(test)
test_qr_matches_client :: proc(t: ^testing.T) {
	for v in VECS {
		c, ok := encode(v.text, .M)
		testing.expectf(t, ok, "encode %q failed", v.text)
		if !ok do continue
		testing.expectf(t, c.size == len(v.rows), "%q: size %d, want %d", v.text, c.size, len(v.rows))
		if c.size != len(v.rows) do continue
		bad := 0
		for row, r in v.rows do for ch, col in row do if (ch == '1') != dark(&c, r, col) do bad += 1
		testing.expectf(t, bad == 0, "%q: %d modules differ from the client's qr.js (mask %d)", v.text, bad, c.mask)
	}
}

@(test)
test_qr_too_long :: proc(t: ^testing.T) {
	buf: [3000]u8
	for &b in buf do b = 'a'
	_, ok := encode(string(buf[:]), .M)
	testing.expect(t, !ok)
}
