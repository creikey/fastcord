# Open the private test guild from the server list, then its #general.
use a
mark setup
click [data-list-item-id="guildsnav___home"]
wait 1500
reload
mark open_guild
click [data-list-item-id="guildsnav___${TGUILD}"]
wait_for [data-list-item-id="channels___${TTEXT}"]
settle 1500
mark open_channel
click [data-list-item-id="channels___${TTEXT}"]
wait_for div[role="textbox"][aria-label^="Message "]
settle 2000
