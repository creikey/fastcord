# A removes B as a friend (Friends -> All -> context menu -> confirm).
use b
mark setup_b
reload
use a
mark setup
reload
include _friends_home.scn
click_text [role="tab"] | All
wait_for [data-list-item-id$="___${DM_AB}"]
settle 1000
mark friend_remove
rclick_text main div[class*="peopleListItem"] | bobbles
wait_for [role="menu"]
js [...document.querySelectorAll('[role=menuitem]')].map(e=>e.id).join(' ')
click #user-context-remove-friend
wait_for [role="dialog"]
pause
click_text [role="dialog"] button | Remove Friend
wait_gw RELATIONSHIP_REMOVE
use b
wait_gw RELATIONSHIP_REMOVE 20000
settle 2500
