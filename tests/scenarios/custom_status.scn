# Set a custom status from the account popout, then clear it.
use a
mark setup
reload
include _friends_home.scn
mark open_custom_status
click div[class*="accountPopoutButton"]
wait 1200
click [aria-label="Add custom status"]
wait 1500
mark set_custom_status
type testing fastcord
key Enter
optional wait_gw USER_SETTINGS_PROTO_UPDATE 10000
settle 2500
mark clear_custom_status
click div[class*="accountPopoutButton"]
wait 1500
optional hover [aria-label*="status" i][class*="outer"]
optional wait 800
optional click [aria-label="Clear custom status"]
optional wait_gw USER_SETTINGS_PROTO_UPDATE 10000
settle 2500
key Escape
settle 1000
