# Status: Online -> Idle -> Online via the account popout (the popout stays open).
use a
mark setup
reload
include _friends_home.scn
mark open_status_menu
click div[class*="accountPopoutButton"]
wait 1200
click_text [role="dialog"] div[role="button"][class*="menuItemContent"] | Your Status: || Idle || Online || Do Not Disturb || Invisible
wait 1200
mark set_idle
click #set-status-submenu-idle
optional wait_gw USER_SETTINGS_PROTO_UPDATE 10000
settle 2500
mark set_online
click_text [role="dialog"] div[role="button"][class*="menuItemContent"] | Your Status: || Idle || Online || Do Not Disturb || Invisible
wait 1200
click #set-status-submenu-online
optional wait_gw USER_SETTINGS_PROTO_UPDATE 10000
settle 2500
key Escape
wait 500
